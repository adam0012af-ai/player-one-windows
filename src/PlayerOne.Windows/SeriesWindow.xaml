<Window x:Class="PlayerOne.Windows.SeriesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Player One • Series" Width="1180" Height="720" WindowStartupLocation="CenterScreen"><Grid Background="#020304" Margin="8"><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition/></Grid.RowDefinitions><Grid><TextBlock Text="PLAYER ONE SERIES" Foreground="#6FE8D1" FontSize="10" FontWeight="Black" VerticalAlignment="Center"/><TextBlock x:Name="SeriesTitle" Foreground="White" FontSize="19" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="130"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#D9070A0E" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="15" Padding="9"><StackPanel><Border Height="310" CornerRadius="12" Background="#071A32" ClipToBounds="True"><Image x:Name="SeriesPoster" Stretch="UniformToFill"/></Border><TextBlock x:Name="SeriesName" Foreground="White" FontSize="16" FontWeight="Black" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock x:Name="EpisodeCount" Foreground="#6FE8D1" FontSize="10" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel></Border><Border Grid.Column="1" Margin="5,0" Background="#C9070A0E" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="15" Padding="5"><DockPanel><TextBlock Text="Seasons" DockPanel.Dock="Top" Foreground="White" FontSize="13" FontWeight="Black" Margin="5"/><ListBox x:Name="Seasons" SelectionChanged="Season_Changed" BorderThickness="0"/></DockPanel></Border><Grid Grid.Column="2" Margin="4,0,0,0"><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition/></Grid.RowDefinitions><TextBlock x:Name="SeasonLabel" Foreground="#A9BED4" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/><ListBox Grid.Row="1" x:Name="Episodes" Background="Transparent" BorderThickness="0" Mous