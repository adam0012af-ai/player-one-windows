<Window x:Class="PlayerOne.Windows.LibraryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="My Library" Width="950" Height="650" Background="#070B12"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><Button Content="Continue Watching" Click="Continue_Click" Padding="15,8" Margin="4"/><Button Content="Favorites" Click="Favorites_Click" Padding="15,8" Margin="4"/></StackPanel><ListBox x:Name="Items" Grid.Row="1" Margin="0,18,0,0" MouseDoubleClick="Open_Click"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8"><TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Subtitle}" Opacity=".65"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Window>