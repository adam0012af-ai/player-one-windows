<Window x:Class="PlayerOne.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Player One" Width="1280" Height="720" MinWidth="900" MinHeight="500" WindowStartupLocation="CenterScreen" KeyDown="Window_KeyDown">
<Grid>
<Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#05070B" Offset="0"/><GradientStop Color="#06080D" Offset=".45"/><GradientStop Color="#0B111A" Offset=".72"/><GradientStop Color="#05070B" Offset="1"/></LinearGradientBrush></Grid.Background>
<Ellipse Width="620" Height="620" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-190,-170,0" IsHitTestVisible="False"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#1F8BCBFF" Offset="0"/><GradientStop Color="#008BCBFF" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
<Grid x:Name="BootstrapView"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="680"><TextBlock x:Name="StatusText" Text="Preparing this device…" Foreground="White" FontSize="27" FontWeight="Black" HorizontalAlignment="Center"/><TextBlock x:Name="SubText" Text="Connecting to Player One…" Foreground="#9BA8BA" FontSize="14" Margin="0,10,0,24" HorizontalAlignment="Center"/><Border Background="#E610141C" BorderBrush="#308BCBFF" BorderThickness="1" CornerRadius="20" Padding="24"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="DEVICE ID" Foreground="#9BA8BA" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="DeviceIdText" Foreground="White" FontSize="18" FontWeight="Black" Margin="0,6,20,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="DEVICE KEY" Foreground="#9BA8BA" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="DeviceKeyText" Foreground="White" FontSize="18" FontWeight="Black" Margin="0,6,0,0"/></StackPanel></Grid></Border><Button x:Name="ContinueButton" Content="CONTINUE" IsEnabled="False" Click="Continue_Click" Height="50" Margin="0,20,0,0" Background="#208BCBFF"/></StackPanel></Grid>
<Grid x:Name="HomeView" Visibility="Collapsed" Margin="18,10">
 <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <Grid>
   <Button Width="38" Height="38" HorizontalAlignment="Left" VerticalAlignment="Center" Click="Exit_Click" Padding="0" ToolTip="Exit"><TextBlock Text="×" FontSize="22" Foreground="#B8FFFFFF"/></Button>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
     <StackPanel VerticalAlignment="Center" Margin="0,0,10,0"><TextBlock Text="PLAYER ONE" Foreground="White" FontSize="17" FontWeight="Black" HorizontalAlignment="Right"/><TextBlock Text="WATCH. SIMPLE. FAST." Foreground="#9BA8BA" FontSize="7" FontWeight="Bold" HorizontalAlignment="Right"/></StackPanel>
     <Border Width="42" Height="42" CornerRadius="13" Background="#1A8BCBFF" BorderBrush="#3D8BCBFF" BorderThickness="1"><TextBlock Text="P1" Foreground="#8BCBFF" FontSize="13" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   </StackPanel>
   <Button Width="105" Height="38" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Settings_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" Foreground="#8BCBFF" FontSize="16"/><TextBlock Text=" Settings" Foreground="White" FontSize="11" FontWeight="Black"/></StackPanel></Button>
 </Grid>
 <UniformGrid Grid.Row="2" Columns="3" Rows="1" Margin="8,10" VerticalAlignment="Stretch">
   <Button Click="Live_Click" Margin="7" Padding="0"><Grid><Border CornerRadius="22" BorderBrush="#138BCBFF" BorderThickness="1"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#1273C8FF"/><GradientStop Color="#171D28" Offset=".45"/><GradientStop Color="#0B0E14" Offset="1"/></LinearGradientBrush></Border.Background></Border><Border Width="58" Height="58" CornerRadius="18" Background="#0DFFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="22"><TextBlock Text="◉" Foreground="#73C8FF" FontSize="29" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Bottom" Margin="22"><TextBlock Text="Live TV" Foreground="White" FontSize="23" FontWeight="Black"/><TextBlock Text="Live channels &amp; categories" Foreground="#9BA8BA" FontSize="10" Margin="0,5,0,0"/><Border Width="38" Height="3" CornerRadius="2" Background="#7373C8FF" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Grid></Button>
   <Button Click="Movies_Click" Margin="7" Padding="0"><Grid><Border CornerRadius="22" BorderBrush="#13FFFFFF" BorderThickness="1"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#129BC8FF"/><GradientStop Color="#171D28" Offset=".45"/><GradientStop Color="#0B0E14" Offset="1"/></LinearGradientBrush></Border.Background></Border><Border Width="58" Height="58" CornerRadius="18" Background="#0DFFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="22"><TextBlock Text="▶" Foreground="#9BC8FF" FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Bottom" Margin="22"><TextBlock Text="Movies" Foreground="White" FontSize="23" FontWeight="Black"/><TextBlock Text="Your movie library" Foreground="#9BA8BA" FontSize="10" Margin="0,5,0,0"/><Border Width="38" Height="3" CornerRadius="2" Background="#739BC8FF" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Grid></Button>
   <Button Click="Series_Click" Margin="7" Padding="0"><Grid><Border CornerRadius="22" BorderBrush="#13FFFFFF" BorderThickness="1"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#12B3D9FF"/><GradientStop Color="#171D28" Offset=".45"/><GradientStop Color="#0B0E14" Offset="1"/></LinearGradientBrush></Border.Background></Border><Border Width="58" Height="58" CornerRadius="18" Background="#0DFFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="22"><TextBlock Text="▣" Foreground="#B3D9FF" FontSize="29" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Bottom" Margin="22"><TextBlock Text="Series" Foreground="White" FontSize="23" FontWeight="Black"/><TextBlock Text="Seasons &amp; episodes" Foreground="#9BA8BA" FontSize="10" Margin="0,5,0,0"/><Border Width="38" Height="3" CornerRadius="2" Background="#73B3D9FF" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Grid></Button>
 </UniformGrid>
</Grid>
</Grid></Window>