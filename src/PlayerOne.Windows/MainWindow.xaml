<Window x:Class="PlayerOne.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Player One" Width="1280" Height="760" MinWidth="900" MinHeight="560" Background="#070B12" WindowStartupLocation="CenterScreen">
<Grid><Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Border Background="#0B111B" Padding="28,0"><DockPanel VerticalAlignment="Center"><TextBlock Text="PLAYER ONE" Foreground="White" FontSize="27" FontWeight="Black" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Playlists" Click="Playlists_Click" Margin="5" Padding="14,7"/><Button Content="Info" Click="Info_Click" Margin="5" Padding="14,7"/><Button Content="Settings" Click="Settings_Click" Margin="5" Padding="14,7"/></StackPanel></DockPanel></Border>
<Grid Grid.Row="1" Margin="34"><Grid x:Name="BootstrapView"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="720"><TextBlock x:Name="StatusText" Text="Preparing this device…" Foreground="White" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="SubText" Text="Connecting to Player One…" Foreground="#9AA7B7" FontSize="15" Margin="0,12,0,28" HorizontalAlignment="Center"/><Border Background="#101925" CornerRadius="18" Padding="24"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Device ID" Foreground="#8B98A8"/><TextBlock x:Name="DeviceIdText" Foreground="White" FontSize="19" FontWeight="Bold" Margin="0,7,20,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Device Key" Foreground="#8B98A8"/><TextBlock x:Name="DeviceKeyText" Foreground="White" FontSize="19" FontWeight="Bold" Margin="0,7,0,0"/></StackPanel></Grid></Border><Button x:Name="ContinueButton" Content="Continue" IsEnabled="False" Click="Continue_Click" Height="48" Margin="0,24,0,0"/></StackPanel></Grid>
<Grid x:Name="HomeView" Visibility="Collapsed"><StackPanel VerticalAlignment="Center"><TextBlock Text="Watch your content" Foreground="White" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,34"/><UniformGrid Columns="3" Rows="1" Height="210"><Button Content="LIVE" Click="Live_Click" Margin="10" FontSize="26"/><Button Content="MOVIES" Click="Movies_Click" Margin="10" FontSize="26"/><Button Content="SERIES" Click="Series_Click" Margin="10" FontSize="26"/></UniformGrid><TextBlock x:Name="HomeInfo" Foreground="#91A0B2" HorizontalAlignment="Center" Margin="0,26,0,0"/></StackPanel></Grid>
</Grid></Grid></Window>