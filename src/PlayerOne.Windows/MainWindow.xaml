<Window x:Class="PlayerOne.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Player One" Width="1280" Height="760" MinWidth="960" MinHeight="600" WindowStartupLocation="CenterScreen">
<Grid><Grid.Background><RadialGradientBrush Center=".5,0" GradientOrigin=".5,0" RadiusX=".85" RadiusY=".85"><GradientStop Color="#123C67" Offset="0"/><GradientStop Color="#03101F" Offset=".42"/><GradientStop Color="#01050C" Offset="1"/></RadialGradientBrush></Grid.Background>
<Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Border Background="#C9071A30" BorderBrush="#55155A96" BorderThickness="0,0,0,1" Padding="22,0"><Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="38" Height="38" CornerRadius="11" Background="#149BFF"><TextBlock Text="▶" Foreground="White" FontSize="17" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="PLAYER ONE" Foreground="White" FontSize="17" FontWeight="Black" CharacterSpacing="80"/><TextBlock Text="MEDIA PLAYER" Foreground="#9BB1C9" FontSize="9"/></StackPanel></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="▤" ToolTip="Library" Click="Library_Click" Margin="4" Width="42" Height="40"/><Button Content="☷" ToolTip="Playlists" Click="Playlists_Click" Margin="4" Width="42" Height="40"/><Button Content="ⓘ" ToolTip="Info" Click="Info_Click" Margin="4" Width="42" Height="40"/><Button Content="⚙" ToolTip="Settings" Click="Settings_Click" Margin="4" Width="42" Height="40"/></StackPanel></Grid></Border>
<Grid Grid.Row="1" Margin="24">
<Grid x:Name="BootstrapView"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="680"><TextBlock x:Name="StatusText" Text="Preparing this device…" Foreground="White" FontSize="27" FontWeight="Black" HorizontalAlignment="Center"/><TextBlock x:Name="SubText" Text="Connecting to Player One…" Foreground="#9BB1C9" FontSize="14" Margin="0,10,0,24" HorizontalAlignment="Center"/><Border Background="#E6071A30" BorderBrush="#155A96" BorderThickness="1" CornerRadius="20" Padding="24"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="DEVICE ID" Foreground="#9BB1C9" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="DeviceIdText" Foreground="White" FontSize="18" FontWeight="Black" Margin="0,6,20,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="DEVICE KEY" Foreground="#9BB1C9" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="DeviceKeyText" Foreground="White" FontSize="18" FontWeight="Black" Margin="0,6,0,0"/></StackPanel></Grid></Border><Button x:Name="ContinueButton" Content="CONTINUE" IsEnabled="False" Click="Continue_Click" Height="50" Margin="0,20,0,0" Background="#149BFF" Foreground="#01050C"/></StackPanel></Grid>
<Grid x:Name="HomeView" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="190"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="4,8,4,16"><StackPanel><TextBlock Text="Your entertainment" Foreground="#149BFF" FontSize="11" FontWeight="Bold"/><TextBlock Text="Watch your content" Foreground="White" FontSize="28" FontWeight="Black"/></StackPanel><TextBlock x:Name="HomeInfo" Foreground="#9BB1C9" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="11"/></Grid>
<UniformGrid Grid.Row="1" Columns="3" Rows="1"><Button Click="Live_Click" Margin="6" Padding="0"><Grid><Border Background="#D9071A30" CornerRadius="18"/><TextBlock Text="◉" Foreground="#149BFF" FontSize="48" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,36,0"/><StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="22"><TextBlock Text="Live TV" FontSize="24" FontWeight="Black"/><TextBlock Text="Live channels" Foreground="#9BB1C9" FontSize="12"/></StackPanel></Grid></Button><Button Click="Movies_Click" Margin="6" Padding="0"><Grid><Border Background="#D9071A30" CornerRadius="18"/><TextBlock Text="▶" Foreground="#149BFF" FontSize="45" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,40,0"/><StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="22"><TextBlock Text="Movies" FontSize="24" FontWeight="Black"/><TextBlock Text="Movie library" Foreground="#9BB1C9" FontSize="12"/></StackPanel></Grid></Button><Button Click="Series_Click" Margin="6" Padding="0"><Grid><Border Background="#D9071A30" CornerRadius="18"/><TextBlock Text="▣" Foreground="#149BFF" FontSize="45" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,40,0"/><StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="22"><TextBlock Text="Series" FontSize="24" FontWeight="Black"/><TextBlock Text="Seasons &amp; episodes" Foreground="#9BB1C9" FontSize="12"/></StackPanel></Grid></Button></UniformGrid>
<Border Grid.Row="2" Margin="6,12,6,4" Background="#B903101F" BorderBrush="#55155A96" BorderThickness="1" CornerRadius="18"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="PLAYER ONE" Foreground="#149BFF" FontSize="14" FontWeight="Black"/><TextBlock Text="Select a section above to browse your library" Foreground="#9BB1C9" FontSize="13" Margin="0,8,0,0"/></StackPanel></Border>
</Grid></Grid></Grid></Window>