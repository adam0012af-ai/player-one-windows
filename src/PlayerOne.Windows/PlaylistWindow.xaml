<Window x:Class="PlayerOne.Windows.PlaylistWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Player One • Playlists" Width="1040" Height="650" WindowStartupLocation="CenterOwner"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="PLAYLIST CENTER" Foreground="#149BFF" FontSize="10" FontWeight="Black"/><TextBlock Text="Playlists" Foreground="White" FontSize="30" FontWeight="Black"/><TextBlock Text="Manage the content sources linked to this device" Foreground="#9BB1C9" FontSize="12" Margin="0,4,0,0"/></StackPanel><ListBox x:Name="List" Grid.Row="1" Margin="0,18" DisplayMemberPath="Name" FontSize="16"/><WrapPanel Grid.Row="2" HorizontalAlignment="Center"><Button Content="USE SELECTED" Click="Select_Click" Margin="4"/><Button Content="REFRESH" Click="Refresh_Click" Margin="4"/><Button Content="+ M3U" Click="AddM3u_Click" Margin="4"/><Button Content="+ XTREAM" Click="AddXtream_Click" Margin="4"/><Button Content="HOST CODE" Click="Code_Click" Margin="4"/><Button Content="EDIT" Click="Edit_Click" Margin="4"/><Button Content="DELETE" Click="Delete_Click" Margin="4" Foreground="#FF667A"/></WrapPanel></Grid></Window>