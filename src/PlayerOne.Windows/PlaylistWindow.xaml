<Window x:Class="PlayerOne.Windows.PlaylistWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Player One • Playlists" Width="1100" Height="680" WindowStartupLocation="CenterOwner"><Grid Background="#03050A"><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition/><RowDefinition Height="58"/></Grid.RowDefinitions><Border Background="#D9070A10" BorderBrush="#10FFFFFF" BorderThickness="0,0,0,1"><Grid Margin="10,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="Playlists" Foreground="White" FontSize="19" FontWeight="Black"/><TextBlock Text="Select a playlist. Edit or delete from the actions below." Foreground="#A9BED4" FontSize="10"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="REFRESH" Click="Refresh_Click" Margin="3"/><Button Content="+ ADD M3U" Click="AddM3u_Click" Margin="3" Background="#186FE8D1"/><Button Content="+ ADD XTREAM" Click="AddXtream_Click" Margin="3" Background="#186FE8D1"/></StackPanel></Grid></Border><Grid Grid.Row="1" Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#08090C" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="16" Padding="14"><StackPanel><TextBlock Text="PLAYER ONE" Foreground="#6FE8D1" FontSize="10" FontWeight="Black"/><TextBlock Text="Device" Foreground="White" FontSize="22" FontWeight="Black" Margin="0,5,0,0"/><TextBlock Text="Lists linked to this device are shown here." Foreground="#A9BED4" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/><Button Content="HOST CODE" Click="Code_Click" Margin="0,18,0,0"/></StackPanel></Border><Border Grid.Column="1" Margin="10,0,0,0" Background="#070A10" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="16" Padding="8"><ListBox x:Name="List" DisplayMemberPath="Name" FontSize="16" BorderThickness="0"/></Border></Grid><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Button Content="USE SELECTED" Click="Select_Click" Margin="4" Background="#186FE8D1"/><Button Content="EDIT" Click="Edit_Click" Margin="4"/><Button Content="DELETE" Click="Delete_Click" Margin="4" Foreground="#FF6B78"/></StackPanel></Grid></Window>