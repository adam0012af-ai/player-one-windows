<Window x:Class="PlayerOne.Windows.CatalogWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Player One" Width="1250" Height="760" Background="#070B12" WindowStartupLocation="CenterScreen"><Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><DockPanel><TextBlock x:Name="TitleText" Foreground="White" FontSize="28" FontWeight="Bold"/><TextBox x:Name="SearchBox" Width="320" Height="36" HorizontalAlignment="Right" TextChanged="Search_Changed"/></DockPanel><Grid Grid.Row="1" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition/></Grid.ColumnDefinitions><ListBox x:Name="Groups" SelectionChanged="Group_Changed"/><ListBox x:Name="Items" Grid.Column="1" Margin="14,0,0,0" MouseDoubleClick="Item_DoubleClick"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8"><TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Group}" Opacity=".65"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Grid></Window>