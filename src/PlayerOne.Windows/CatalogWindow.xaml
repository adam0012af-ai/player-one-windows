<Window x:Class="PlayerOne.Windows.CatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Player One" Width="1320" Height="800" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen" KeyDown="Window_KeyDown">
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition/></Grid.RowDefinitions>
    <Grid>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="←" Width="42" Height="42" Margin="0,0,12,0" Click="Back_Click"/>
        <StackPanel>
          <TextBlock Text="PLAYER ONE" Foreground="#6FE8D1" FontSize="9" FontWeight="Black"/>
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="TitleText" Foreground="White" FontSize="25" FontWeight="Black"/>
            <TextBlock x:Name="CountText" Foreground="#A9BED4" FontSize="11" Margin="12,10,0,0"/>
          </StackPanel>
        </StackPanel>
      </StackPanel>
      <TextBox x:Name="SearchBox" Width="320" Height="42" HorizontalAlignment="Right" VerticalAlignment="Center"
               TextChanged="Search_Changed" ToolTip="Search"/>
    </Grid>

    <Grid Grid.Row="1" Margin="0,10,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="248"/><ColumnDefinition/></Grid.ColumnDefinitions>

      <Border Background="#08090C" BorderBrush="#204B78" BorderThickness="1" CornerRadius="18" Padding="8">
        <DockPanel>
          <TextBlock Text="CATEGORIES" DockPanel.Dock="Top" Foreground="#A9BED4" FontSize="10" FontWeight="Black" Margin="8"/>
          <ListBox x:Name="Groups" SelectionChanged="Group_Changed" BorderThickness="0"
                   ScrollViewer.CanContentScroll="True"
                   VirtualizingPanel.IsVirtualizing="True"
                   VirtualizingPanel.VirtualizationMode="Recycling"/>
        </DockPanel>
      </Border>

      <Border Grid.Column="1" Margin="10,0,0,0" Background="#66070915" BorderBrush="#33204B78"
              BorderThickness="1" CornerRadius="18" Padding="10">
        <ListBox x:Name="Items" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Tag="{Binding}" Click="Card_Click" PreviewKeyDown="Card_KeyDown"
                            Margin="6" Padding="0" Background="Transparent" BorderThickness="0">
                      <Border Width="160" Height="242" Background="#09090B" BorderBrush="#14FFFFFF"
                              BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                        <Grid>
                          <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="62"/></Grid.RowDefinitions>
                          <Grid Background="#070709">
                            <Image Source="{Binding Image}" Stretch="UniformToFill"/>
                            <TextBlock Text="▶" Foreground="#446FE8D1" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Grid>
                          <Border Grid.Row="1" Background="#0B0B0D" Padding="9,6">
                            <StackPanel>
                              <TextBlock Text="{Binding Name}" Foreground="White" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                              <TextBlock Text="{Binding Group}" Foreground="#A9BED4" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                            </StackPanel>
                          </Border>
                        </Grid>
                      </Border>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </Grid>
  </Grid>
</Window>
