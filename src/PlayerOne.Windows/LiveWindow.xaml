<Window x:Class="PlayerOne.Windows.LiveWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Player One • Live" Width="1320" Height="800" MinWidth="900" MinHeight="520" WindowStartupLocation="CenterScreen" KeyDown="Window_KeyDown"><Grid Background="#020202"><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition/></Grid.RowDefinitions><Grid Background="#070709" Margin="8,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Content="←" Width="40" Height="40" Click="Back_Click"/><StackPanel Margin="8,0"><TextBlock Text="Live" Foreground="White" FontSize="17" FontWeight="Black"/><TextBlock x:Name="CountText" Foreground="#A9BED4" FontSize="10"/></StackPanel></StackPanel><TextBox x:Name="SearchBox" Width="286" Height="40" HorizontalAlignment="Right" VerticalAlignment="Center" TextChanged="Search_Changed"/></Grid><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="212"/><ColumnDefinition/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions><Border Background="#090A0D" BorderBrush="#204B78" BorderThickness="0,1,1,0"><DockPanel><TextBlock Text="CATEGORIES" Foreground="White" FontWeight="Black" Margin="12" DockPanel.Dock="Top"/><ListBox x:Name="Groups" SelectionChanged="Group_Changed" BorderThickness="0"/></DockPanel></Border><Border Grid.Column="1" Background="#070709"><ListBox x:Name="Channels" BorderThickness="0" Background="Transparent" SelectionChanged="Channel_Changed" MouseDoubleClick="Channel_DoubleClick"><ListBox.ItemTemplate><DataTemplate><Border Height="44" Padding="7" Background="#09090B" BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding Number}" Foreground="#A9BED4" VerticalAlignment="Center"/><Image Grid.Column="1" Source="{Binding Item.Image}" Stretch="Uniform"/><StackPanel Grid.Column="2" Margin="7,0"><TextBlock Text="{Binding Item.Name}" Foreground="White" FontWeight="Bold"/><TextBlock Text="{Binding Item.Group}" Foreground="#A9BED4" FontSize="10"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Border><Border Grid.Column="2" Background="#08080A" BorderBrush="#204B78" BorderThickness="1,0,0,0" Padding="14"><StackPanel VerticalAlignment="Center"><Image x:Name="PreviewImage" Height="210" Stretch="Uniform"/><TextBlock x:Name="PreviewName" Foreground="White" FontSize="20" FontWeight="Black" TextAlignment="Center" Margin="0,12,0,0"/><TextBlock x:Name="PreviewGroup" Foreground="#A9BED4" TextAlignment="Center" Margin="0,5"/><Button Content="PLAY" Click="Play_Click" Height="42" Margin="0,12" Background="#226FE8D1"/><Button Content="★ FAVORITE" Click="Favorite_Click" Height="38"/></StackPanel></Border></Grid></Grid></Window>