<Window x:Class="PlayerOne.Windows.MovieDetailsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Movie Details" Width="1000" Height="620" Background="#070B12"><Grid Margin="32"><Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#101925" CornerRadius="18"><Image x:Name="Poster" Stretch="UniformToFill"/></Border><StackPanel Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="MovieTitle" Foreground="White" FontSize="32" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock x:Name="Meta" Foreground="#63D7C6" FontSize="15" Margin="0,12"/><TextBlock x:Name="Plot" Foreground="#C5CED9" FontSize="15" TextWrapping="Wrap" MaxHeight="180"/><TextBlock x:Name="Credits" Foreground="#8997A8" Margin="0,14,0,0" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,24,0,0"><Button Content="Play" Click="Play_Click" Padding="25,10" Margin="4"/><Button x:Name="Fav" Content="Favorite" Click="Fav_Click" Padding="20,10" Margin="4"/></StackPanel></StackPanel></Grid></Window>