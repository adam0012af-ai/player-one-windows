<Window x:Class="PlayerOne.Windows.MovieDetailsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Player One • Movie" Width="1120" Height="680" WindowStartupLocation="CenterScreen" KeyDown="Window_KeyDown"><Grid><Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#020915"/><GradientStop Color="#071A32" Offset=".55"/><GradientStop Color="#01050C" Offset="1"/></LinearGradientBrush></Grid.Background><Grid Margin="34"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#071A30" BorderBrush="#204B78" BorderThickness="1" CornerRadius="20" ClipToBounds="True"><Image x:Name="Poster" Stretch="UniformToFill"/></Border><StackPanel Grid.Column="1" Margin="34,0,0,0" VerticalAlignment="Center"><Button Content="←" Click="Back_Click" Width="42" Height="38" HorizontalAlignment="Left" Margin="0,0,0,10"/><TextBlock Text="MOVIE DETAILS" Foreground="#6FE8D1" FontSize="10" FontWeight="Black"/><TextBlock x:Name="MovieTitle" Foreground="White" FontSize="36" FontWeight="Black" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock x:Name="Meta" Foreground="#149BFF" FontSize="14" FontWeight="Bold" Margin="0,12"/><TextBlock x:Name="Plot" Foreground="#F4F9FF" FontSize="15" LineHeight="23" TextWrapping="Wrap" MaxHeight="190"/><TextBlock x:Name="Credits" Foreground="#A9BED4" Margin="0,16,0,0" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,26,0,0"><Button Content="▶  PLAY" Click="Play_Click" Padding="28,11" Margin="0,0,8,0" Background="#149BFF" Foreground="#01050C"/><Button x:Name="Fav" Content="☆  FAVORITE" Click="Fav_Click" Padding="22,11"/></StackPanel></StackPanel></Grid></Grid></Window>