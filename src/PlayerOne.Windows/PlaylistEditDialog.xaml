<Window x:Class="PlayerOne.Windows.PlaylistEditDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="560" Height="500" Title="Player One • Playlist" WindowStartupLocation="CenterOwner"><Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><StackPanel><TextBlock Text="PLAYLIST CENTER" Foreground="#149BFF" FontSize="10" FontWeight="Black"/><TextBlock Text="Playlist details" Foreground="White" FontSize="27" FontWeight="Black" Margin="0,3,0,18"/></StackPanel><StackPanel Grid.Row="1"><TextBlock Text="Name" Foreground="#9BB1C9"/><TextBox x:Name="NameBox" Margin="0,5,0,10"/><TextBlock Text="M3U URL" Foreground="#9BB1C9"/><TextBox x:Name="UrlBox" Margin="0,5,0,10"/><TextBlock Text="Server / Host" Foreground="#9BB1C9"/><TextBox x:Name="HostBox" Margin="0,5,0,10"/><TextBlock Text="Username" Foreground="#9BB1C9"/><TextBox x:Name="UserBox" Margin="0,5,0,10"/><TextBlock Text="Password" Foreground="#9BB1C9"/><PasswordBox x:Name="PassBox" Margin="0,5" Padding="12,8" Background="#071A30" Foreground="White" BorderBrush="#155A96"/><Button Content="SAVE" Click="Save_Click" Margin="0,18,0,0" Height="44" Background="#149BFF" Foreground="#01050C"/></StackPanel></Grid></Window>