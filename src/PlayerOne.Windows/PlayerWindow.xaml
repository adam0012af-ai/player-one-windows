<Window x:Class="PlayerOne.Windows.PlayerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF" Title="Player One • Player" Width="1200" Height="720" Background="Black" WindowStartupLocation="CenterScreen" KeyDown="Window_KeyDown">
<Grid><vlc:VideoView x:Name="VideoView"/>
<Border VerticalAlignment="Bottom" Background="#D0000000" Padding="16"><DockPanel>
<StackPanel><TextBlock x:Name="NowPlaying" Foreground="White" FontSize="18"/><TextBlock x:Name="PlayerStatus" Foreground="#A7B3C2" FontSize="12"/></StackPanel>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
<Button Content="⏯" Click="Pause_Click" Margin="4"/><Button Content="◀ 10s" Click="Back_Click" Margin="4"/><Button Content="10s ▶" Click="Forward_Click" Margin="4"/>
<Button Content="Fit / Fill / Stretch" Click="Aspect_Click" Margin="4"/><Button Content="Compact" Click="Compact_Click" Margin="4"/><Button Content="Fullscreen" Click="Full_Click" Margin="4"/>
</StackPanel></DockPanel></Border></Grid></Window>