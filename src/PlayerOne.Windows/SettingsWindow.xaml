<Window x:Class="PlayerOne.Windows.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="720" Height="650" Title="Player One • Settings" WindowStartupLocation="CenterOwner"><ScrollViewer><StackPanel Margin="30"><Button Content="Back" Click="Back_Click" HorizontalAlignment="Left" Margin="0,0,0,8"/><TextBlock Text="PLAYER ONE" Foreground="#6FE8D1" FontSize="10" FontWeight="Black"/><TextBlock Text="Settings" Foreground="White" FontSize="28" FontWeight="Black"/><Border Background="#08090C" BorderBrush="#204B78" BorderThickness="1" CornerRadius="18" Padding="22" Margin="0,20,0,0"><StackPanel><CheckBox x:Name="Reconnect" Content="Auto reconnect" Margin="0,5"/><CheckBox x:Name="AutoNext" Content="Auto play next" Margin="0,10"/><CheckBox x:Name="KeepScreen" Content="Keep screen awake" Margin="0,10"/><CheckBox x:Name="Subs" Content="Subtitles enabled" Margin="0,10"/><TextBlock Text="Streaming format" Foreground="#A9BED4" Margin="0,10,0,0"/><ComboBox x:Name="StreamFormat" Margin="0,6"><ComboBoxItem Content="auto"/><ComboBoxItem Content="hls"/><ComboBoxItem Content="ts"/></ComboBox><TextBlock Text="Buffer profile" Foreground="#A9BED4" Margin="0,6,0,0"/><ComboBox x:Name="BufferProfile" Margin="0,6"><ComboBoxItem Content="fast"/><ComboBoxItem Content="balanced"/><ComboBoxItem Content="stable"/></ComboBox><TextBlock Text="Aspect" Foreground="#A9BED4" Margin="0,10,0,0"/><ComboBox x:Name="Aspect" Margin="0,6"><ComboBoxItem Content="fit"/><ComboBoxItem Content="fill"/><ComboBoxItem Content="zoom"/></ComboBox><TextBlock Text="Language" Foreground="#A9BED4" Margin="0,6,0,0"/><ComboBox x:Name="Language" Margin="0,6"><ComboBoxItem Content="ar"/><ComboBoxItem Content="en"/></ComboBox><TextBlock Text="Audio language" Foreground="#A9BED4" Margin="0,6,0,0"/><ComboBox x:Name="Audio" Margin="0,6"><ComboBoxItem Content="auto"/><ComboBoxItem Content="ar"/><ComboBoxItem Content="en"/><ComboBoxItem Content="fr"/><ComboBoxItem Content="es"/><ComboBoxItem Content="de"/><ComboBoxItem Content="tr"/></ComboBox><TextBlock Text="Subtitle language" Foreground="#A9BED4" Margin="0,6,0,0"/><ComboBox x:Name="Subtitle" Margin="0,6"><ComboBoxItem Content="auto"/><ComboBoxItem Content="ar"/><ComboBoxItem Content="en"/><ComboBoxItem Content="fr"/><ComboBoxItem Content="es"/><ComboBoxItem Content="de"/><ComboBoxItem Content="tr"/></ComboBox></StackPanel></Border><Button Content="SAVE SETTINGS" Click="Save_Click" Height="46" Margin="0,18,0,0" Background="#6FE8D1" Foreground="#020915"/></StackPanel></ScrollViewer></Window>