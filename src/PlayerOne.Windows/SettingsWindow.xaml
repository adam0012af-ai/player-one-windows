<Window x:Class="PlayerOne.Windows.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="720" Height="650" Title="Player One • Settings" WindowStartupLocation="CenterOwner"><ScrollViewer><StackPanel Margin="30"><TextBlock Text="PLAYER ONE" Foreground="#149BFF" FontSize="10" FontWeight="Black"/><TextBlock Text="Settings" Foreground="White" FontSize="28" FontWeight="Black"/><Border Background="#071A30" BorderBrush="#155A96" BorderThickness="1" CornerRadius="18" Padding="22" Margin="0,20,0,0"><StackPanel><CheckBox x:Name="Reconnect" Content="Auto reconnect" Margin="0,5"/><CheckBox x:Name="Background" Content="Background playback" Margin="0,10"/><CheckBox x:Name="Subs" Content="Subtitles enabled" Margin="0,10"/><CheckBox x:Name="Remember" Content="Remember last section" Margin="0,10"/><TextBlock Text="Aspect" Foreground="#9BB1C9" Margin="0,10,0,0"/><ComboBox x:Name="Aspect" Margin="0,6"><ComboBoxItem Content="fit"/><ComboBoxItem Content="fill"/><ComboBoxItem Content="zoom"/></ComboBox><TextBlock Text="Language" Foreground="#9BB1C9" Margin="0,6,0,0"/><ComboBox x:Name="Language" Margin="0,6"><ComboBoxItem Content="ar"/><ComboBoxItem Content="en"/></ComboBox><TextBlock Text="Audio language" Foreground="#9BB1C9" Margin="0,6,0,0"/><ComboBox x:Name="Audio" Margin="0,6"><ComboBoxItem Content="auto"/><ComboBoxItem Content="ar"/><ComboBoxItem Content="en"/><ComboBoxItem Content="fr"/><ComboBoxItem Content="es"/><ComboBoxItem Content="de"/><ComboBoxItem Content="tr"/></ComboBox><TextBlock Text="Subtitle language" Foreground="#9BB1C9" Margin="0,6,0,0"/><ComboBox x:Name="Subtitle" Margin="0,6"><ComboBoxItem Content="auto"/><ComboBoxItem Content="ar"/><ComboBoxItem Content="en"/><ComboBoxItem Content="fr"/><ComboBoxItem Content="es"/><ComboBoxItem Content="de"/><ComboBoxItem Content="tr"/></ComboBox></StackPanel></Border><Button Content="SAVE SETTINGS" Click="Save_Click" Height="46" Margin="0,1