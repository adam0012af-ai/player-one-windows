<Application x:Class="PlayerOne.Windows.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
<Application.Resources>
  <!-- Exact Android main CinematicTheme palette -->
  <SolidColorBrush x:Key="XBlack" Color="#020915"/><SolidColorBrush x:Key="XNight" Color="#061326"/><SolidColorBrush x:Key="XPanel" Color="#F2071A32"/><SolidColorBrush x:Key="XPanel2" Color="#0A2342"/><SolidColorBrush x:Key="XLine" Color="#204B78"/><SolidColorBrush x:Key="XText" Color="#F4F9FF"/><SolidColorBrush x:Key="XMuted" Color="#A9BED4"/><SolidColorBrush x:Key="XMint" Color="#6FE8D1"/><SolidColorBrush x:Key="XBlue" Color="#47B7FF"/><SolidColorBrush x:Key="XAmber" Color="#D9ECFF"/><SolidColorBrush x:Key="XViolet" Color="#86D6FF"/><SolidColorBrush x:Key="XRose" Color="#8AB8FF"/><SolidColorBrush x:Key="XTeal" Color="#4DDBFF"/><SolidColorBrush x:Key="XSuccess" Color="#62D493"/><SolidColorBrush x:Key="XWarning" Color="#F1B761"/><SolidColorBrush x:Key="XDanger" Color="#FF6B78"/>
  <Style TargetType="Window"><Setter Property="Background" Value="#06080D"/><Setter Property="Foreground" Value="{StaticResource XText}"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
  <Style TargetType="Button"><Setter Property="Foreground" Value="{StaticResource XText}"/><Setter Property="Background" Value="#10141C"/><Setter Property="BorderBrush" Value="#13FFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#21171D28"/><Setter TargetName="B" Property="BorderBrush" Value="#8BCBFF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#8BCBFF"/><Setter TargetName="B" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="{StaticResource XText}"/><Setter Property="Background" Value="#11161F"/><Setter Property="BorderBrush" Value="#20FFFFFF"/><Setter Property="CaretBrush" Value="#8BCBFF"/><Setter Property="Padding" Value="12,8"/></Style>
  <Style TargetType="ListBox"><Setter Property="Foreground" Value="{StaticResource XText}"/><Setter Property="Background" Value="#11161F"/><Setter Property="BorderBrush" Value="#14FFFFFF"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="{StaticResource XText}"/><Setter Property="Padding" Value="8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#101820"/><Setter Property="Padding" Value="8"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource XText}"/></Style>
</Application.Resources></Application>